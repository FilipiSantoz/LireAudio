{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna Analyzer",
  "version": "0.1.0",
  "identifier": "luna-analyzer",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../frontend && bun run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "cd ../frontend && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Luna Analyzer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
